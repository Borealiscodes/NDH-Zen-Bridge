    { "from": "HOLONOMY_CHECK", "to": "DIAGNOSTIC_INTERFACE_CHECK", "condition": "holonomy_transport_safe" },
    { "from": "HOLONOMY_CHECK", "to": "VALIDATION_FAIL", "condition": "holonomy_propagation_breach" },

    { "from": "DIAGNOSTIC_INTERFACE_CHECK", "to": "FRACTAL_INTERFACE_CHECK", "condition": "diagnostic_reversible_ascent" },
    { "from": "DIAGNOSTIC_INTERFACE_CHECK", "to": "VALIDATION_FAIL", "condition": "diagnostic_collapse_or_irreversibility" },

    { "from": "FRACTAL_INTERFACE_CHECK", "to": "GOVERNANCE_BOUNDARY_CHECK", "condition": "fractal_schema_binding_safe" },
    { "from": "FRACTAL_INTERFACE_CHECK", "to": "VALIDATION_FAIL", "condition": "fractal_misalignment_or_unbounded_binding" },

    { "from": "GOVERNANCE_BOUNDARY_CHECK", "to": "EXPRESSIVE_BUFFER_CHECK", "condition": "governance_non_absorption" },
    { "from": "GOVERNANCE_BOUNDARY_CHECK", "to": "VALIDATION_FAIL", "condition": "governance_absorption_or_sealed_layer_breach" },

    { "from": "EXPRESSIVE_BUFFER_CHECK", "to": "SOVEREIGNTY_CHECK", "condition": "expressive_non_contamination" },
    { "from": "EXPRESSIVE_BUFFER_CHECK", "to": "VALIDATION_FAIL", "condition": "expressive_contamination_detected" },

    { "from": "SOVEREIGNTY_CHECK", "to": "VALIDATION_PASS", "condition": "sovereignty_preserved" },
